{
  "redirects": [
    { "source": "/proto/journey", "destination": "/", "permanent": true },
    { "source": "/proto/journey/:path*", "destination": "/", "permanent": true },
    { "source": "/proto/v5/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/keys", "destination": "/api/account?route=keys" },
    { "source": "/api/share", "destination": "/api/account?route=share" },
    { "source": "/api/docs", "destination": "/api/account?route=docs" },
    { "source": "/api/pages", "destination": "/api/account?route=pages" },
    { "source": "/api/workspaces", "destination": "/api/account?route=workspaces" },
    { "source": "/api/prefs", "destination": "/api/account?route=prefs" },
    { "source": "/api/tool", "destination": "/api/account?route=tool" },
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/v1/:tool*", "destination": "/api/v1?tool=:tool*" },
    { "source": "/mcp/v1", "destination": "/api/mcp" },
    { "source": "/((?!api/|mcp/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|mcp/|assets/|fonts/|starters/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
