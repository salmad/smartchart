# Slide system (see docs/superpowers/specs/2026-09-26-slide-system-architecture-design.md)
# GLM subscription (coding endpoint): main model for writing slide content
GLM_API_KEY=your_api_key_here
# OpenRouter: used ONLY for Jev (template routing, closed-set decisions, design checks)
OPENROUTER_API_KEY=your_api_key_here

# Legacy chart app (to be replaced by the proxy; keys are exposed to the browser)
# Google Gemini API Key (primary AI provider)
VITE_GEMINI_API_KEY=your_api_key_here
# Claude API Key (fallback AI provider)
VITE_ANTHROPIC_API_KEY=your_api_key_here
